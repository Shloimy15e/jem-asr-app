# Full fine-tune variant — use when dataset is large enough (>50h) and you
# want to push state-of-the-art vs. LoRA adapter quality.
# Graduated eval cadence (20 → 100 → 200 → 500) borrowed from the old pipeline.

HF_DATASET_REPO=ABE101/jem-yi-whisper-training
HF_MODEL_ORG=ABE101
OUTPUT_MODEL_NAME=jem-whisper-full-v1

BASE_MODEL=ivrit-ai/yi-whisper-large-v3-turbo
TARGET_LANGUAGE=yiddish

# No LoRA — updates all parameters
USE_QLORA=0
MIXED_PRECISION=bf16

# Full fine-tune needs smaller batch + gradient checkpointing to fit on 1× A6000/A100
PER_DEVICE_TRAIN_BATCH_SIZE=1
PER_DEVICE_EVAL_BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=16
LEARNING_RATE=1e-5
WARMUP_STEPS=200
NUM_TRAIN_EPOCHS=5
WEIGHT_DECAY=0.05

# Graduated eval — cheap early, thorough late
EVAL_STEPS=100
SAVE_STEPS=100
LOGGING_STEPS=10
MAX_CHECKPOINTS_TO_KEEP=5

INCLUDE_TIMESTAMPS_PROB=0.5
INCLUDE_PREV_TEXT_PROB=0.5

EVAL_DATASETS=

RUN_NAME=jem-full-v1
