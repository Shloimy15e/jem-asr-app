# Base Yiddish model v2 — full FT on the pooled corpus.
# Mirrors ivrit-ai's published yi-whisper-large-v3-turbo recipe (full FT, LR
# 5e-6, 500 warmup, bf16) but trains on a larger corpus by adding Facebook's
# Omnilingual Yiddish data on top of ivrit-ai's two crowd sets.
#
# Pooled training data (all space-separated, concatenated by ivrit-ai's
# preperator.process_datasets — NOT interleaved, so source weighting is
# proportional to row counts):
#   - ivrit-ai/crowd-recital-yi-whisper-training       ~78h, gated (HF_TOKEN required)
#   - ivrit-ai/crowd-whatsapp-yi-whisper-training      ~19h, gated
#   - ABE101/omnilingual-ydd-Hebr-ivrit-format         ~12.7h train, push first
#                                                      via scripts/convert-omnilingual-to-ivrit-format.py
#
# Held-out eval: omnilingual dev split (1.57h, speakers disjoint from train).

# ── Where the fine-tuned model gets pushed ──────────────────────────────
HF_MODEL_ORG=ABE101
OUTPUT_MODEL_NAME=yi-whisper-large-v3-turbo-jem-base-v2

# ── Base model: start from openai's turbo (NOT ivrit-ai's tuned one) ────
# Rationale: we're rebuilding the Yiddish base from scratch with a larger
# corpus, not continuing ivrit-ai's run. Continued FT from yi-whisper risks
# catastrophic forgetting on omnilingual's distribution; clean rebuild is
# safer at this data scale.
BASE_MODEL=openai/whisper-large-v3-turbo
TARGET_LANGUAGE=yiddish

# ── Multi-dataset pool ──────────────────────────────────────────────────
# Bootstrap.sh splits this on whitespace via `read -ra` and passes each as a
# separate argv element to --train_datasets (nargs="*").
TRAIN_DATASETS="ivrit-ai/crowd-recital-yi-whisper-training:train ivrit-ai/crowd-whatsapp-yi-whisper-training:train ABE101/omnilingual-ydd-Hebr-ivrit-format:train"
EVAL_DATASETS="ABE101/omnilingual-ydd-Hebr-ivrit-format:dev"

# ── Method: full fine-tune (USE_QLORA unset = default false) ────────────
# USE_QLORA=0 — leave commented; train-whisper.py treats absent as false.
MIXED_PRECISION=bf16

# ── Hyperparameters: mirror ivrit-ai's published yi-whisper recipe ──────
# Their run: bf16 + sdpa, LR 5e-6 linear decay, 500 warmup, 4 epochs, batch 32
# on 8× A40. Single-GPU here uses grad_accum to hit the same effective batch.
LEARNING_RATE=5e-6
WARMUP_STEPS=500
NUM_TRAIN_EPOCHS=4
WEIGHT_DECAY=0.05

# Effective batch = per_device_batch × grad_accum × num_gpus.
# 1 × 16 × 1 = 16 (vs. ivrit-ai's 32×8=256). Bump grad_accum if VRAM allows.
PER_DEVICE_TRAIN_BATCH_SIZE=1
PER_DEVICE_EVAL_BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=16

# ── Eval + checkpointing ────────────────────────────────────────────────
EVAL_STEPS=200
SAVE_STEPS=200
LOGGING_STEPS=10
MAX_CHECKPOINTS_TO_KEEP=5
PREDICT_WER=1

# ── Conditioning probabilities (matches ivrit-ai methodology) ───────────
INCLUDE_TIMESTAMPS_PROB=0.5
INCLUDE_PREV_TEXT_PROB=0.5

# ── Tracking ────────────────────────────────────────────────────────────
RUN_NAME=jem-base-v2-pooled
