# Config sourced by training/pod/bootstrap.sh.
# Every KEY=VALUE maps to a flag on ivrit-ai's train-whisper.py — no parser layer.
# See vendor/asr-training/train-whisper.py for every available flag.
#
# Default: QLoRA fine-tune of ivrit-ai's Yiddish Whisper turbo, Hebrew-script.
# Pass a different --config path to bootstrap.sh to override.

# ── Where the dataset lives (pushed by training/push-dataset.sh) ────────
HF_DATASET_REPO=ABE101/jem-yi-whisper-training

# ── Where the fine-tuned model gets pushed ──────────────────────────────
HF_MODEL_ORG=ABE101
OUTPUT_MODEL_NAME=jem-whisper-lora-v1

# ── Base model + language ───────────────────────────────────────────────
BASE_MODEL=ivrit-ai/yi-whisper-large-v3-turbo
TARGET_LANGUAGE=yiddish

# ── Method: QLoRA (matches ivrit-ai default for parameter-efficient FT) ─
USE_QLORA=1
MIXED_PRECISION=bf16

# ── Batch + optimizer ───────────────────────────────────────────────────
PER_DEVICE_TRAIN_BATCH_SIZE=2
PER_DEVICE_EVAL_BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=8
LEARNING_RATE=1e-4
WARMUP_STEPS=20
NUM_TRAIN_EPOCHS=25
WEIGHT_DECAY=0.05

# ── Eval + checkpointing ────────────────────────────────────────────────
# PREDICT_WER requires an eval dataset. Set EVAL_DATASETS below or drop this.
# For first-pass with no separate eval split, comment out PREDICT_WER.
EVAL_STEPS=5
SAVE_STEPS=5
LOGGING_STEPS=1
MAX_CHECKPOINTS_TO_KEEP=10
# PREDICT_WER=1   # uncomment once EVAL_DATASETS is populated

# ── Training conditioning probabilities (ivrit-ai methodology) ──────────
INCLUDE_TIMESTAMPS_PROB=0.5
INCLUDE_PREV_TEXT_PROB=0.5

# ── Eval dataset (optional — leave empty to skip eval) ──────────────────
# Point at a separate held-out dataset, or a split within HF_DATASET_REPO.
# Format: "dataset_name[:split_name]" (space-separated for multiple).
EVAL_DATASETS=

# ── Tracking ────────────────────────────────────────────────────────────
RUN_NAME=jem-lora-v1
